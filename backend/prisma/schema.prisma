// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id                    Int             @id @default(autoincrement())
  patientId             Int? // Making this optional for existing records
  patient               Patient?        @relation(fields: [patientId], references: [id])
  patientName           String
  patientPhone          String
  patientVisibleId      String?
  date                  DateTime
  time                  String
  type                  String          @default("Consultation")
  duration              String
  status                String          @default("Confirmed")
  notes                 String?         @db.Text
  doctorId              Int? // Doctor assigned to this appointment
  doctorName            String? // Doctor name for quick access
  // Official consultation times (for business logic/billing)
  consultationStartTime DateTime? // Official scheduled start time
  consultationEndTime   DateTime? // Official scheduled end time
  // Actual consultation times (for analysis)
  actualStartTime       DateTime? // When doctor actually started
  actualEndTime         DateTime? // When doctor actually ended
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  emergencyCase         EmergencyCase?
  emergencyCaseId       Int?
  prescriptions         Prescription[] // Relation to prescriptions
  vitals                PatientVitals[] // Relation to vitals
  bills                 Bill[] // Relation to bills

  @@index([patientId])
}

model Patient {
  id                          Int                    @id @default(autoincrement())
  visibleId                   String                 @unique
  name                        String                 @db.VarChar(100)
  age                         Int
  gender                      String                 @db.VarChar(20)
  phone                       String                 @db.VarChar(20)
  phoneRelationship           String?                @db.VarChar(50) // Relationship if phone is shared (e.g., "Father", "Mother")
  email                       String?                @db.VarChar(100)
  condition                   String?                @db.VarChar(200)
  status                      String                 @default("Active") @db.VarChar(50)
  allergies                   String[]
  lastVisit                   DateTime?
  abhaId                      String?                @unique @db.VarChar(50)
  abhaVerified                Boolean                @default(false)
  emergencyContact            String?                @db.VarChar(100)
  emergencyPhone              String?                @db.VarChar(20)
  address                     String?                @db.Text
  consultationStatus          String?                @db.VarChar(20) // 'active', 'completed', null
  // Official consultation time (for business consistency)
  consultationStartTime       DateTime? // Official scheduled start time
  // Actual consultation time (for analysis)
  actualConsultationStartTime DateTime? // When consultation actually started
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  appointments                Appointment[]
  emergencyCases              EmergencyCase[]
  createdFromEmergency        Boolean                @default(false)
  medicalReports              MedicalReport[] // New relation
  prescriptions               Prescription[] // Relation to prescriptions
  vitals                      PatientVitals[] // Relation to vitals
  bills                       Bill[] // Relation to bills
  emergencyContacts           PatientEmergencyContact[] // Multiple emergency contacts

  @@index([phone])
}

model PatientEmergencyContact {
  id           Int     @id @default(autoincrement())
  patientId    Int
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String  @db.VarChar(100)
  relationship String? @db.VarChar(50) // e.g., "Father", "Mother", "Spouse", "Friend"
  phone        String  @db.VarChar(20)
  isPrimary    Boolean @default(false) // Mark one as primary contact
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([patientId])
  @@index([patientId, isPrimary])
}

model AppointmentSettings {
  id                    Int      @id @default(autoincrement())
  workingHoursStart     String // e.g. "08:00"
  workingHoursEnd       String // e.g. "18:00"
  breakStart            String // e.g. "12:00"
  breakEnd              String // e.g. "13:00"
  durations             Json // Array of { value: string, label: string, isActive: boolean }
  appointmentTypes      String[] // e.g. ["Consultation", "Follow-up", ...]
  maxAppointmentsPerDay Int      @default(50)
  allowOverlapping      Boolean  @default(false)
  bufferTime            Int      @default(15) // in minutes
  advanceBookingDays    Int      @default(30)
  autoGenerateSlots     Boolean  @default(true)
  defaultDuration       String   @default("30")
  timeSlots             Json // Array of { id: string, time: string, isActive: boolean }
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model HospitalSettings {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  phone     String
  email     String
  website   String?
  license   String?
  director  String?
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailConfiguration {
  id           Int      @id @default(autoincrement())
  smtpPort     String
  smtpUsername String
  smtpPassword String
  senderEmail  String
  smtpHost     String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model InventoryItem {
  id            Int              @id @default(autoincrement())
  code          String           @unique
  name          String
  category      String
  currentStock  Int
  minStock      Int
  maxStock      Int
  unit          String
  pricePerUnit  Float
  supplier      String
  expiryDate    DateTime? // Nullable for items like equipment
  batchNumber   String?
  lastRestocked DateTime?
  reason        String? // Reason for last stock update
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  batches       InventoryBatch[]
  billItems     BillItem[] // Relation to bill items
  auditLogs     InventoryAudit[] // Relation to audit logs
}

model InventoryAudit {
  id              Int           @id @default(autoincrement())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId Int
  action          String        // "STOCK_IN", "STOCK_OUT", "ADJUSTMENT", "BILLING", "EXPIRED", "DAMAGED"
  quantityBefore  Int           // Stock before the action
  quantityAfter   Int           // Stock after the action
  quantityChanged Int           // Positive for stock in, negative for stock out
  reason          String?       // Reason for the change
  reference       String?       // Reference to bill, batch, etc.
  referenceId     Int?          // ID of the reference (billId, batchId, etc.)
  performedBy     String?       // User who performed the action
  notes           String?       // Additional notes
  createdAt       DateTime      @default(now())

  @@index([inventoryItemId])
  @@index([action])
  @@index([createdAt])
}

model InventoryCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  website       String?
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EmergencyCase {
  id             Int          @id @default(autoincrement())
  patientId      Int
  patient        Patient      @relation(fields: [patientId], references: [id])
  chiefComplaint String
  arrivalTime    DateTime
  triagePriority String
  assignedTo     String
  status         String
  vitals         Json
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  appointmentId  Int?         @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  transferStatus String       @default("Not Transferred")
  transferTo     String?
  transferReason String?
  transferNotes  String?
  transferTime   DateTime?

  @@index([patientId])
  @@index([appointmentId])
}

model InventoryBatch {
  id              Int           @id @default(autoincrement())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  inventoryItemId Int
  batchNumber     String
  quantity        Int
  expiryDate      DateTime?
  restockedAt     DateTime      @default(now())
  supplier        String?
  reason          String?
}

model MedicalReport {
  id          Int      @id @default(autoincrement())
  filePath    String // Path to uploaded file
  uploadedAt  DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id])
  patientId   Int
  description String? // Optional: description or label for the report
}

model Staff {
  id                 Int               @id @default(autoincrement())
  employeeId         String?           @unique @db.VarChar(50) // Auto-generated employee ID
  name               String            @db.VarChar(100)
  role               String            @db.VarChar(50)
  gender             String?           @db.VarChar(10)
  dateOfBirth        DateTime?
  qualification      String?
  registrationNumber String?           @db.VarChar(100) // Doctor's registration number
  experience         String?
  phone              String?           @db.VarChar(20)
  email              String?           @db.VarChar(100)
  dateOfHiring       DateTime?
  status             String            @default("On Duty") @db.VarChar(20)
  shiftId            Int? // Reference to Shift model
  weekOff            String?           @db.VarChar(20) // Day of the week
  consultationFee    String?
  digitalSignature   String? // Path to digital signature image or base64 encoded signature
  documents          String[] // Array of document paths
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  departmentId       Int?
  department         Department?       @relation(fields: [departmentId], references: [id])
  shiftTime          Shift?            @relation(fields: [shiftId], references: [id])
  statusLogs         StaffStatusLog[] // Relation to status change logs

  @@index([departmentId])
  @@index([shiftId])
  @@index([role])
}

model StaffStatusLog {
  id             Int      @id @default(autoincrement())
  staffId        Int
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  previousStatus String?  @db.VarChar(50)
  newStatus      String   @db.VarChar(50)
  changeType     String   @db.VarChar(20) // 'automatic' or 'manual'
  changedBy      String?  @db.VarChar(100) // User who made the change (null for automatic)
  reason         String?  @db.Text // Reason for manual changes
  timestamp      DateTime @default(now())

  @@index([staffId])
  @@index([timestamp])
  @@index([changeType])
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff[]
}

model Shift {
  id        Int      @id @default(autoincrement())
  name      String
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff[] // Relationship with Staff
}

model RolePermission {
  id          Int      @id @default(autoincrement())
  role        String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PatientVitals {
  id               Int          @id @default(autoincrement())
  patientId        Int
  patient          Patient      @relation(fields: [patientId], references: [id])
  appointmentId    Int?
  appointment      Appointment? @relation(fields: [appointmentId], references: [id])
  bloodPressureSys Int? // Systolic blood pressure
  bloodPressureDia Int? // Diastolic blood pressure
  heartRate        Int? // Heart rate in bpm
  temperature      Float? // Temperature in Fahrenheit
  respiratoryRate  Int? // Respiratory rate per minute
  oxygenSaturation Int? // Oxygen saturation percentage
  weight           Float? // Weight in lbs
  height           Float? // Height in inches
  recordedBy       String? // Who recorded the vitals (doctor/nurse)
  notes            String? // Additional notes
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([patientId, appointmentId], name: "unique_patient_appointment_vitals")
  @@index([patientId])
  @@index([appointmentId])
}

model Prescription {
  id                       Int                      @id @default(autoincrement())
  patientId                Int
  patient                  Patient                  @relation(fields: [patientId], references: [id])
  appointmentId            Int?
  appointment              Appointment?             @relation(fields: [appointmentId], references: [id])
  // Store patient info directly for easy access
  patientName              String?
  patientVisibleId         String?
  patientAge               Int?
  patientGender            String?
  chiefComplaint           String?                  @db.Text
  investigations           String?                  @db.Text
  doctorNotes              String?                  @db.Text
  advice                   String?                  @db.Text
  doctorName               String
  doctorQualification      String?
  doctorRegistrationNumber String?
  doctorSignature          String?
  medications              PrescriptionMedication[]
  bills                    Bill[] // Relation to bills
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([patientId])
  @@index([appointmentId])
}

model PrescriptionMedication {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  frequency      String
  timing         String       @default("No meal restriction")
  duration       String
  createdAt      DateTime     @default(now())

  @@index([prescriptionId])
}

model Bill {
  id             Int           @id @default(autoincrement())
  billNumber     String        @unique
  patientId      Int
  patient        Patient       @relation(fields: [patientId], references: [id])
  appointmentId  Int?
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  prescriptionId Int?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  // Bill details
  subtotal    Float  @default(0)
  gstAmount   Float  @default(0) // Total GST amount (sum of all item GST amounts)
  totalAmount Float
  status      String @default("Pending") // Pending, Paid, Overdue, Cancelled

  // Payment details
  paymentMethod String? // Cash, UPI, Card, etc.
  paymentDate   DateTime?

  // Bill items
  items BillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([appointmentId])
  @@index([prescriptionId])
}

model GstCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g., "Medicine", "Cosmetic", "Lab Test"
  description String? // Optional description
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  gstRates GstRate[]
}

model GstRate {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g., "Medicine GST", "Cosmetic GST", "Lab Test GST"
  rate        Float // GST percentage (e.g., 5, 12, 18, 28)
  description String? // Optional description
  categoryId  Int? // Reference to GstCategory
  category    GstCategory? @relation(fields: [categoryId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  billItems BillItem[]

  @@index([categoryId])
}

model BillItem {
  id     Int  @id @default(autoincrement())
  billId Int
  bill   Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  // Item details
  itemType    String // "medicine", "service", "consultation"
  itemName    String
  description String?

  // Pricing
  quantity   Float @default(1)
  unitPrice  Float
  totalPrice Float

  // Medicine specific (if itemType = "medicine")
  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  // GST application - now using GST rates
  gstRateId Int?
  gstRate   GstRate? @relation(fields: [gstRateId], references: [id])
  gstAmount Float    @default(0) // Calculated GST amount for this item

  createdAt DateTime @default(now())

  @@index([billId])
  @@index([inventoryItemId])
  @@index([gstRateId])
}

model VitalsSettings {
  id        Int      @id @default(autoincrement())
  vitalType String   @unique // "bloodPressure", "heartRate", "temperature", "respiratoryRate", "oxygenSaturation", "weight", "height"
  name      String // Display name
  unit      String // Unit of measurement
  minNormal Float? // Minimum normal value
  maxNormal Float? // Maximum normal value
  minCritical Float? // Minimum critical value (below this is critical)
  maxCritical Float? // Maximum critical value (above this is critical)
  isActive  Boolean  @default(true)
  notes     String? // Additional notes or guidelines
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
